# =============================================================================
# fastmart-ai — environment
#
#   cp .env.example .env      then fill in every REQUIRED value below.
#
# .env is gitignored. Start a PRODUCTION file from this template as-is; for the
# local dev stack see "LOCAL DEV OVERRIDES" at the bottom (4 lines differ).
# =============================================================================

# ===== REQUIRED — public identity =====
# The host n8n serves on. Drives the webhook URLs the widget calls, so it must
# be the public name the browser resolves (not localhost).
N8N_HOST=ai.perfectobd.com
N8N_PROTOCOL=https
N8N_SECURE_COOKIE=true
# Where n8n listens on the host. 127.0.0.1 = reached only by the reverse proxy
# in front of it. Set to 0.0.0.0 to expose the port directly instead.
N8N_BIND=127.0.0.1
N8N_PORT=5678

# ===== REQUIRED — secrets =====
# ⚠ N8N_ENCRYPTION_KEY is the one value you COPY, not generate. Take it from the
#   instance you are migrating from (that machine's fastmart-ai/.env).
#
#   n8n encrypts every credential you store in the UI (the Gemini API key, the
#   Postgres connection) with this key before writing it to its own database.
#   Step 3 restores that database as-is, so the encrypted blobs arrive intact —
#   but they can only be decrypted by the identical key. Generate a fresh one
#   here and those credentials become permanently unreadable: the editor flags
#   them as undecryptable and every workflow using them fails. The workflows
#   themselves restore fine, which makes the failure look unrelated to the key.
#
#   A fresh key is only correct for a brand-new install with no restore — in
#   that case you recreate both credentials by hand in the UI.
#   Set it once, never change it.
N8N_ENCRYPTION_KEY=

# The remaining secrets ARE generated — each with:  openssl rand -hex 32
# (The fill loop in README.md covers exactly these six and skips the key above.)
N8N_USER_MANAGEMENT_JWT_SECRET=

# n8n Assistant sandbox + its bundled web search.
# SANDBOX_API_KEYS doubles as n8n's service key — it must contain the value the
# sandbox-api compares against, so keep it a single generated hex string.
SANDBOX_API_KEYS=
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=
SANDBOX_API_RUNNER_API_KEY=
SEARXNG_SECRET=

# ===== REQUIRED — the store =====
# Base URL for every store API call the workflows make. No trailing slash.
# Read at RUNTIME by the Code nodes (cart context, blocks/price-guard).
# The httpRequestTool nodes have this host baked in at build time instead — see
# "Day-to-day dev loop" in README.md.
STORE_BASE_URL=https://perfectobd.com

# ===== REQUIRED — n8n's own Postgres (never the store DB) =====
# This is where n8n keeps its workflows and credentials. The container creates
# the database from scratch, so there is no existing password to match — you are
# inventing this credential for a new database. `openssl rand -hex 32` is ideal;
# it is never exposed (the port is not published to the host).
# It is used twice from this one value: the postgres container's password and
# n8n's DB_POSTGRESDB_PASSWORD.
# ⚠ Set it once and keep it. Postgres applies this only when it first
#   initialises the postgres_data volume — change it later and the DB keeps the
#   old password while n8n starts sending the new one, so n8n cannot connect.
POSTGRES_DB=fastmart_n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=

# ===== Timezone (Asia/Dhaka = your local business day) =====
GENERIC_TIMEZONE=Asia/Dhaka
TZ=Asia/Dhaka

# ===== n8n Assistant (instance-ai module) =====
# Needs a model key + the sandbox services in docker-compose.yml.
N8N_ENABLED_MODULES=instance-ai

# Model: any OpenAI-compatible endpoint. Default is Command Code's gateway —
# the same endpoint the "OpenAI compatible Commandcode" workflow credential uses,
# so ONE key covers both the agent workflows and the Assistant.
#
# The "custom/" prefix is REQUIRED for any model whose real id contains a "/".
# instance-ai splits this value at the FIRST "/" and reads the head as an n8n
# provider name. Command Code's ids are namespaced (deepseek/deepseek-v4.1-flash),
# and "deepseek" happens to be a provider n8n ships, so without "custom/" n8n
# routes through @ai-sdk/deepseek and sends only "deepseek-v4.1-flash" — which the
# gateway rejects ("Model ... is not supported on this endpoint") and the turn
# then dies with "No output generated". "custom/" is the generic provider and
# strips only itself, so the rest is forwarded verbatim.
N8N_INSTANCE_AI_MODEL=custom/deepseek/deepseek-v4.1-flash
N8N_INSTANCE_AI_MODEL_API_KEY=
# Command Code's OpenAI-compatible root. Required (it is the custom provider's
# baseURL) — copy it from the credential's "Base URL" field.
N8N_INSTANCE_AI_MODEL_URL=https://api.commandcode.ai/provider/v1
# Only used if you route the Assistant back through the local gemini-sig-proxy
# (that service is still in docker-compose.yml, just unused): the proxy is what
# fixes Gemini 3's multi-step tool calling, and forwards to this API.
GEMINI_UPSTREAM=https://generativelanguage.googleapis.com/v1beta/openai
# Other OpenAI-compatible providers work the same way, e.g.:
#   OpenRouter: N8N_INSTANCE_AI_MODEL=openrouter/google/gemini-2.5-pro
#               N8N_INSTANCE_AI_MODEL_URL=   (built in)
#               N8N_INSTANCE_AI_MODEL_API_KEY=sk-or-xxx

N8N_INSTANCE_AI_SANDBOX_IMAGE=ghcr.io/n8n-io/n8n-sandbox-service-sandbox:latest

# =============================================================================
# NOT SET HERE — pinned in docker-compose.yml, do not change
#   NODE_FUNCTION_ALLOW_BUILTIN=...    the Code nodes need http,https,url. Task
#                                      runners are always on in n8n 2+, and this
#                                      is the setting that grants them the builtins.
#   N8N_BLOCK_ENV_ACCESS_IN_NODE=false Code nodes read $env.STORE_BASE_URL
#   N8N_RUNNERS_TASK_TIMEOUT=300       n8n 3 shortens the default to 60s
# Setting them here has no effect: the compose file hardcodes them.
# See "Upgrading n8n" in README.md for the v3 breaking-change checklist.
# =============================================================================

# =============================================================================
# LOCAL DEV OVERRIDES
# For the local stack (docker-compose.dev.yml), change only these four lines:
#
#   N8N_HOST=localhost
#   N8N_PROTOCOL=http
#   N8N_SECURE_COOKIE=false
#   STORE_BASE_URL=http://fastmart-pro.test
#
# ...and set a Meilisearch key (used only by the dev overlay):
# MEILI_MASTER_KEY=
# =============================================================================

# ===== Deferred (future multi-channel) =====
# WhatsApp Business API / email provider credentials go here when the
# Part 1 Step 6 spike is reached. Out of scope for now.
