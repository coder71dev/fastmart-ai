# ===== n8n =====
# Host / port n8n is served on (container already listens on 5678 internally)
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# Set to true when behind HTTPS (production / reverse proxy with TLS)
N8N_SECURE_COOKIE=false

# REQUIRED for production. Generate once and keep it stable across restarts:
#   openssl rand -hex 32   (or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
N8N_ENCRYPTION_KEY=

# REQUIRED when user management / multi-user is enabled (owner signup)
# If empty, a random secret is generated at runtime (data not shared across restarts).
N8N_USER_MANAGEMENT_JWT_SECRET=

# Timezone so "Asia/Dhaka" wraps daily/weekly in your local business time
GENERIC_TIMEZONE=Asia/Dhaka
TZ=Asia/Dhaka

# ===== Code-node HTTP (IMPORTANT — do not change) =====
# The agent-chat workflows make store HTTP calls from Code nodes (cart context,
# blocks/price-guard re-fetches). n8n's Code-node sandbox has NO $helpers/fetch
# and disallows require('http') by default, so:
#   - N8N_RUNNERS_ENABLED must be false (runners strip even allowed builtins)
#   - NODE_FUNCTION_ALLOW_BUILTIN must include http,https,url
# Verified 2026-09-03: without these the cart context + blocks silently fail.
N8N_RUNNERS_ENABLED=false
NODE_FUNCTION_ALLOW_BUILTIN=http,https,util,path,url,zlib,crypto,stream,events

# Code nodes must be able to read $env.STORE_BASE_URL
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# ===== n8n's own Postgres (NOT the store DB) =====
POSTGRES_DB=fastmart_n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=n8n_password

# ===== Meilisearch (product search used by the store) =====
# Only needed for the local dev stack; on VPS the store has its own search.
#   openssl rand -hex 16
MEILI_MASTER_KEY=

# ===== Store (Perfecto) =====
# Base URL the n8n workflows call for ALL store data (products, cart, orders).
#   Local Laragon: http://fastmart-pro.test
#   VPS / live:    https://perfecto.example.com  (actual live domain)
# Workflows read this value to stay portable between local and VPS.
STORE_BASE_URL=https://example.com

# ===== n8n Assistant (instance-ai) =====
# Preview feature. Needs a model key + a sandbox (provided by the sandbox-* services
# in docker-compose.yml) and optionally the bundled SearXNG for web search.
N8N_ENABLED_MODULES=instance-ai

# Model: any OpenAI-compatible endpoint. Default is Gemini's OpenAI-compatible API
# (same Google AI Studio key as the "Gemini API Palm v3" workflow credential).
N8N_INSTANCE_AI_MODEL=gemini-3.7-flash
N8N_INSTANCE_AI_MODEL_API_KEY=
# Routed through the local gemini-sig-proxy service (see gemini-sig-proxy.mjs),
# which fixes Gemini 3's multi-step tool calling. GEMINI_UPSTREAM is the real API.
N8N_INSTANCE_AI_MODEL_URL=http://gemini-sig-proxy:8017/v1
GEMINI_UPSTREAM=https://generativelanguage.googleapis.com/v1beta/openai
# OpenRouter alternative: N8N_INSTANCE_AI_MODEL=openrouter/google/gemini-2.5-pro
#                         N8N_INSTANCE_AI_MODEL_URL=   (built in)
#                         N8N_INSTANCE_AI_MODEL_API_KEY=sk-or-xxx

# Sandbox (self-hosted n8n-sandbox)
N8N_INSTANCE_AI_SANDBOX_ENABLED=true
N8N_INSTANCE_AI_SANDBOX_PROVIDER=n8n-sandbox
N8N_INSTANCE_AI_SANDBOX_IMAGE=ghcr.io/n8n-io/n8n-sandbox-service-sandbox:latest
N8N_INSTANCE_AI_SEARXNG_URL=http://searxng:8080

# Sandbox service secrets — generate unique values:
#   openssl rand -hex 24
# SANDBOX_API_KEYS is also used as N8N_SANDBOX_SERVICE_API_KEY (they must match).
SANDBOX_API_KEYS=
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=
SANDBOX_API_RUNNER_API_KEY=
SEARXNG_SECRET=

# ===== Deferred (future multi-channel) =====
# WHOP / WhatsApp Business API / email provider credentials go here when
# the Part 1 Step 6 spike is reached. Kept out of scope for now.