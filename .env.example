# ===== n8n =====
# Host / port n8n is served on (container already listens on 5678 internally)
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# Set to true when behind HTTPS (production / reverse proxy with TLS)
N8N_SECURE_COOKIE=false

# REQUIRED for production. Generate once and keep it stable across restarts:
#   openssl rand -hex 32   (or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
N8N_ENCRYPTION_KEY=

# REQUIRED when user management / multi-user is enabled (owner signup)
# If empty, a random secret is generated at runtime (data not shared across restarts).
N8N_USER_MANAGEMENT_JWT_SECRET=

# Timezone so "Asia/Dhaka" wraps daily/weekly in your local business time
GENERIC_TIMEZONE=Asia/Dhaka
TZ=Asia/Dhaka

# ===== n8n's own Postgres (NOT the store DB) =====
POSTGRES_DB=fastmart_n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=n8n_password

# ===== Store (Perfecto) =====
# Base URL the n8n workflows call for ALL store data (products, cart, orders).
#   Local ddev:   http://perfecto.ddev.site  (or your ddev URL)
#   VPS / live:   https://perfecto.example.com  (actual live domain)
# Workflows read this value to stay portable between local and VPS.
STORE_BASE_URL=https://example.com

# ===== Deferred (future multi-channel) =====
# WHOP / WhatsApp Business API / email provider credentials go here when
# the Part 1 Step 6 spike is reached. Kept out of scope for now.