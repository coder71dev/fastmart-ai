# =============================================================================
# fastmart-ai — environment
#
#   cp .env.example .env      then fill in every REQUIRED value below.
#
# .env is gitignored. Start a PRODUCTION file from this template as-is; for the
# local dev stack see "LOCAL DEV OVERRIDES" at the bottom (4 lines differ).
# =============================================================================

# ===== REQUIRED — public identity =====
# The host n8n serves on. Drives the webhook URLs the widget calls, so it must
# be the public name the browser resolves (not localhost).
N8N_HOST=ai.perfectobd.com
N8N_PROTOCOL=https
N8N_SECURE_COOKIE=true
# Where n8n listens on the host. 127.0.0.1 = reached only by the reverse proxy
# in front of it. Set to 0.0.0.0 to expose the port directly instead.
N8N_BIND=127.0.0.1
N8N_PORT=5678

# ===== REQUIRED — secrets =====
# Generate each one with:  openssl rand -hex 32
#
# ⚠ N8N_ENCRYPTION_KEY encrypts the credentials stored in n8n's DB. Set it once
#   and NEVER change it — every stored credential becomes unreadable if it
#   changes. When migrating from an existing instance, reuse that instance's
#   value verbatim, or restoring its DB dump will not decrypt.
N8N_ENCRYPTION_KEY=
N8N_USER_MANAGEMENT_JWT_SECRET=

# n8n Assistant sandbox + its bundled web search.
# SANDBOX_API_KEYS doubles as n8n's service key — it must contain the value the
# sandbox-api compares against, so keep it a single generated hex string.
SANDBOX_API_KEYS=
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=
SANDBOX_API_RUNNER_API_KEY=
SEARXNG_SECRET=

# ===== REQUIRED — the store =====
# Base URL for every store API call the workflows make. No trailing slash.
# Read at RUNTIME by the Code nodes (cart context, blocks/price-guard).
# The httpRequestTool nodes have this host baked in at build time instead — see
# "Day-to-day dev loop" in README.md.
STORE_BASE_URL=https://perfectobd.com

# ===== REQUIRED — n8n's own Postgres (never the store DB) =====
POSTGRES_DB=fastmart_n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=

# ===== Timezone (Asia/Dhaka = your local business day) =====
GENERIC_TIMEZONE=Asia/Dhaka
TZ=Asia/Dhaka

# ===== n8n Assistant (instance-ai module) =====
# Needs a model key + the sandbox services in docker-compose.yml.
N8N_ENABLED_MODULES=instance-ai

# Model: any OpenAI-compatible endpoint. Default is Gemini's OpenAI-compatible
# API (same Google AI Studio key as the "Gemini API Palm v3" workflow credential).
N8N_INSTANCE_AI_MODEL=gemini-3.7-flash
N8N_INSTANCE_AI_MODEL_API_KEY=
# Routed through the local gemini-sig-proxy service (see gemini-sig-proxy.mjs),
# which fixes Gemini 3's multi-step tool calling. GEMINI_UPSTREAM is the real API.
N8N_INSTANCE_AI_MODEL_URL=http://gemini-sig-proxy:8017/v1
GEMINI_UPSTREAM=https://generativelanguage.googleapis.com/v1beta/openai
# OpenRouter alternative: N8N_INSTANCE_AI_MODEL=openrouter/google/gemini-2.5-pro
#                         N8N_INSTANCE_AI_MODEL_URL=   (built in)
#                         N8N_INSTANCE_AI_MODEL_API_KEY=sk-or-xxx

N8N_INSTANCE_AI_SANDBOX_IMAGE=ghcr.io/n8n-io/n8n-sandbox-service-sandbox:latest

# =============================================================================
# NOT SET HERE — pinned in docker-compose.yml, do not change
#   N8N_RUNNERS_ENABLED=false          task runners strip require('http') from
#                                      Code nodes, which the cart context and
#                                      blocks/price-guard depend on
#   NODE_FUNCTION_ALLOW_BUILTIN=...    the Code nodes need http,https,url
#   N8N_BLOCK_ENV_ACCESS_IN_NODE=false Code nodes read $env.STORE_BASE_URL
# Setting them here has no effect: the compose file hardcodes them.
# =============================================================================

# =============================================================================
# LOCAL DEV OVERRIDES
# For the local stack (docker-compose.dev.yml), change only these four lines:
#
#   N8N_HOST=localhost
#   N8N_PROTOCOL=http
#   N8N_SECURE_COOKIE=false
#   STORE_BASE_URL=http://fastmart-pro.test
#
# ...and set a Meilisearch key (used only by the dev overlay):
# MEILI_MASTER_KEY=
# =============================================================================

# ===== Deferred (future multi-channel) =====
# WhatsApp Business API / email provider credentials go here when the
# Part 1 Step 6 spike is reached. Out of scope for now.
